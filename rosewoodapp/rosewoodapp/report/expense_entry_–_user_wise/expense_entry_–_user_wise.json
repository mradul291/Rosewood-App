 "query": "SELECT \n  posting_date,\n  posting_time, \n  entry_type, \n  expense_category,\n  payment_mode,\n  IFNULL(cash_in, 0) as cash_in,\n  IFNULL(cash_out, 0) as cash_out,\n  IFNULL(balance, 0) as balance\nFROM `tabExpense Entry`\nWHERE 1=1\n  AND (entry_by IS NULL OR entry_by = %(entry_by)s)\nORDER BY posting_date DESC, posting_time DESC\n",
