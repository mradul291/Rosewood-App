 "query": "SELECT \n  expense_category,\n  IFNULL(SUM(cash_in), 0) as total_cash_in,\n  IFNULL(SUM(cash_out), 0) as total_cash_out,\n  IFNULL(SUM(balance), 0) as total_balance\nFROM `tabExpense Entry`\nWHERE 1=1\n  AND (expense_category IS NULL OR expense_category = %(expense_category)s)\nGROUP BY expense_category\nORDER BY total_cash_out DESC\n",
